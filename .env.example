# =============================================
# 灵感菇 - 环境变量配置
# =============================================
# 复制此文件为 .env，填入你的 Supabase 项目信息
# 在 https://supabase.com/dashboard 的项目 Settings > API 中获取

# Supabase 项目 URL (必填)
# 格式: https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=your_supabase_project_url

# Supabase Anon Key (必填, 安全可公开)
# 在 Settings > API > Project API keys > anon public 中获取
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 服务端口 (可选, 默认 3000)
PORT=3000

# 运行环境 (可选)
NODE_ENV=development

# =============================================
# 注意事项
# =============================================
# - VITE_ 前缀的变量会被 Vite 注入到前端代码中
# - 不要将 service_role key 放入此文件（只用 anon key）
# - .env 文件已加入 .gitignore，不会上传到代码仓库
